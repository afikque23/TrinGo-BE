@section('content')
<div x-data="{
    showEditModal: false,
    showDeleteModal: false,
    selectedNotification: null,
    testingNotification: null,
    notifications: [
        { id: 1, name: 'Pengingat Servis Rutin', trigger: '200 km sebelum interval', priority: 'High', priorityColor: '#FDC700', channels: 'Push + In-App', message: '🔧 Servis {service_type} dalam {km_remaining} km lagi! Estimasi biaya: {predicted_cost}', threshold: 200, active: true },
        { id: 2, name: 'Peringatan Servis Kritikal', trigger: 'Melewati interval 10%', priority: 'Critical', priorityColor: '#FF6467', channels: 'Push + Email', message: '⚠️ URGENT: Motor Anda sudah melewati jadwal {service_type} sebanyak {km_overdue} km!', threshold: 10, active: true },
        { id: 3, name: 'Rekomendasi Bengkel Terdekat', trigger: 'Servis mendekati interval', priority: 'Normal', priorityColor: '#6A7282', channels: 'In-App', message: '📍 {workshop_name} ({rating} ⭐) berjarak {distance} km. Booking sekarang!', threshold: 150, active: true },
        { id: 4, name: 'Insight Pola Berkendara', trigger: 'Analisis bulanan', priority: 'Low', priorityColor: '#6A7282', channels: 'In-App', message: '📊 Pola berkendara Anda: {riding_pattern}, rata-rata {avg_distance} km/hari 🏍️', threshold: 0, active: true }
    ],
    openEdit(notif) {
        this.selectedNotification = JSON.parse(JSON.stringify(notif));
        this.showEditModal = true;
    },
    openDelete(notif) {
        this.selectedNotification = notif;
        this.showDeleteModal = true;
    },
    async testPush(notifId) {
        this.testingNotification = notifId;
        await new Promise(resolve => setTimeout(resolve, 1500));
        this.testingNotification = null;
        alert('Push notification \"' + this.notifications.find(n => n.id === notifId).name + '\" berhasil dikirim ke test device!');
    },
    toggleActive(notifId) {
        const notif = this.notifications.find(n => n.id === notifId);
        if (notif) notif.active = !notif.active;
    }
}" class="relative">

