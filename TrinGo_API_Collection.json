		{
			"name": "02. Auth - Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (jsonData.access_token) {",
							"    pm.environment.set(\"bearer_token\", jsonData.access_token);",
							"    console.log(\"Bearer token saved successfully!\");",
							"} else if (jsonData.data && jsonData.data.access_token) {",
							"    pm.environment.set(\"bearer_token\", jsonData.data.access_token);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
