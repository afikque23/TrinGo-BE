                        ],
                        "url": {
                            "raw": "{{base_url}}/public/contents/guide",
                            "host": ["{{base_url}}"],
                            "path": ["public", "contents", "guide"]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Get About",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/public/contents/about",
                            "host": ["{{base_url}}"],
                            "path": ["public", "contents", "about"]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Get FAQ",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/public/contents/faq",
                            "host": ["{{base_url}}"],
                            "path": ["public", "contents", "faq"]
                        }
                    },
                    "response": []
                },
                {
                    "name": "Get System Info",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Accept",
                                "value": "application/json",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/public/contents/system_info",
                            "host": ["{{base_url}}"],
                            "path": ["public", "contents", "system_info"]
                        }
                    },
                    "response": []
