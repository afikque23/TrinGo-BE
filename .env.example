APP_NAME=TringGo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=motorcare
DB_USERNAME=root
DB_PASSWORD=

# JWT / Auth
JWT_SECRET=

# FCM (Firebase Cloud Messaging)
FCM_CREDENTIALS_PATH=
FCM_PROJECT_ID=

# MQTT Subscriber
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPICS=
MQTT_QOS=0
MQTT_USE_TLS=false
MQTT_TLS_SELF_SIGNED_ALLOWED=false
MQTT_CONNECT_TIMEOUT=10
MQTT_SOCKET_TIMEOUT=5
MQTT_KEEP_ALIVE=10
MQTT_RECONNECT_DELAY_SECONDS=5
MQTT_CLIENT_ID=

# Optional: append telemetry into trip_points for active trip (end_at=null)
MQTT_TRIP_POINTS_ENABLED=false

# Gemini (Google Generative Language API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=900
GEMINI_SCORE_DELTA_TRIGGER=5
