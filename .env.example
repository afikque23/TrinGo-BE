APP_NAME=TringGo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Database (XAMPP / MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=motorcyclemanagement
DB_USERNAME=root
DB_PASSWORD=

# JWT / Auth
JWT_SECRET=

# FCM (Firebase Cloud Messaging)
FCM_CREDENTIALS_PATH=
FCM_PROJECT_ID=

# Mail (OTP)
# Gmail SMTP biasanya butuh App Password, bukan password akun.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
# true hanya untuk development/debug agar OTP muncul di response JSON.
OTP_EXPOSE_IN_RESPONSE=false

# MQTT Subscriber
MQTT_HOST=127.0.0.1
# NOTE (Windows): Mosquitto v2 service often binds 127.0.0.1:1883 (local-only).
# If you run Mosquitto manually for LAN access (see motorcycle-management-mobile/mosquitto.local.conf), use port 1884.
MQTT_PORT=1884
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPICS=
MQTT_QOS=0
MQTT_USE_TLS=false
MQTT_TLS_SELF_SIGNED_ALLOWED=false
MQTT_CONNECT_TIMEOUT=10
MQTT_SOCKET_TIMEOUT=5
MQTT_KEEP_ALIVE=10
MQTT_RECONNECT_DELAY_SECONDS=5
MQTT_CLIENT_ID=

# Optional: append telemetry into trip_points for active trip (end_at=null)
MQTT_TRIP_POINTS_ENABLED=false

# Gemini (Google Generative Language API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.4
GEMINI_MAX_OUTPUT_TOKENS=900
GEMINI_SCORE_DELTA_TRIGGER=5
