							"    pm.collectionVariables.set('motor_id', list[0].id.toString());",
							"    console.log('motor_id otomatis di-set ke:', list[0].id);",
							"    var sport = list.find(function(v) { return v.tipe_motor === 'sport'; });",
							"    if (sport) {",
							"        pm.collectionVariables.set('motor_id_sport', sport.id.toString());",
							"    } else {",
							"        pm.collectionVariables.set('motor_id_sport', list[0].id.toString());",
							"    }",
							"}"
						],
